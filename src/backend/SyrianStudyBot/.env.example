# JWT
Jwt__Secret=your-secret-key-at-least-32-characters
Jwt__Issuer=YourApp
Jwt__Audience=YourAppUsers
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpiresInDays=7
Jwt__MaxActiveTokensPerUser=5

# Database
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=studybot_phase3;Username=postgres;Password=change_me

# Email (Gmail SMTP)
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__FromEmail=your-email@gmail.com
Email__FromName=Syrian Study Bot
Email__Password=your-app-password

# Ollama (local embeddings)
Ollama__BaseUrl=http://localhost:11434
Ollama__EmbeddingModel=nomic-embed-text

# Groq (fallback chat)
Groq__ApiKey=
Groq__Model=mixtral-8x7b-32768

# OpenRouter (default chat + vision)
OpenRouter__ApiKey=sk-or-v1-your-api-key
OpenRouter__Model=qwen/qwen-2.5-72b-instruct
OpenRouter__VisionModel=openai/gpt-4o-mini

# Document uploads
DocumentUploads__MaxAdminFileSizeBytes=524288000

# Other
ChatProvider=OpenRouter
AppUrl=https://localhost:7001

# AI Service (external extraction service)
AiService__BaseUrl=http://localhost:8000
AiService__PollingIntervalSeconds=5
AiService__TimeoutMinutes=500
AiService__Enabled=false
