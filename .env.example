# ============================================================================
# Syrian Study Assistant — environment template
# Copy to .env and fill in real values. .env is git-ignored; this file is not.
#
# NOTE ON NAMING: the backend (.NET) reads ASP.NET `Section__Key` names. The
# Python ai-service reads BOTH `Section__Key` and `SCREAMING_SNAKE` names
# (see src/ai-service/Config.py::_env_first), so a single .env drives both.
# Keep the model names below in sync with what each provider currently offers.
# ============================================================================

# ---- Database ----
DB_PASSWORD=dev_password
POSTGRES_DB=studybot_phase3

# ---- Embeddings (local Ollama) ----
OLLAMA_HOST=http://host.docker.internal:11434
Ollama__EmbeddingModel=nomic-embed-text

# ---- Backend chat provider ----
ChatProvider=OpenRouter

# ---- Gemini (primary extraction; schema-constrained decoding) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated fallback models tried when GEMINI_MODEL fails (rate-limit, error, etc.)
GEMINI_MODEL_FALLBACKS=gemini-1.5-flash,gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=8192
# Role gates which extraction path a provider serves: text | vision | both.
# Gemini/Groq handle the image (vision) path; OpenRouter/OpenCode handle text.
GEMINI_ROLE=vision

# ---- Groq (fallback extraction, free tier) ----
# mixtral-8x7b is DECOMMISSIONED — do not use it. Use a current instruct model.
GROQ_API_KEY=
Groq__Model=llama-3.3-70b-versatile
Groq__VisionModel=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_SECONDS=120
GROQ_TEMPERATURE=0.1
GROQ_MAX_OUTPUT_TOKENS=8192
# json_schema strict decoding; auto-downgrades to json_object if the model rejects it.
GROQ_STRUCTURED_OUTPUT=true
GROQ_ROLE=vision

# ---- OpenRouter (fallback extraction + backend chat) ----
OPENROUTER_API_KEY=
OpenRouter__Model=qwen/qwen-2.5-72b-instruct
OpenRouter__ModelFallbacks=
OpenRouter__VisionModel=openai/gpt-4o-mini
OpenRouter__VisionModelFallbacks=
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_OUTPUT_TOKENS=8192
OPENROUTER_STRUCTURED_OUTPUT=true
OPENROUTER_ROLE=text

# ---- OpenCode Zen (free-tier fallback) ----
# Set the key to enable OpenCode. It only joins the fallback chain when present.
OPENCODE_API_KEY=
OPENCODE_TIMEOUT_SECONDS=60
# Optional: override the stealth-model lists (comma-separated). Blank = code defaults.
# Images are ONLY sent to the vision list; text models never receive images.
OPENCODE_TEXT_MODELS=
OPENCODE_VISION_MODELS=
OPENCODE_ROLE=text

# ---- Provider fallback tuning ----
# opencode is first so it absorbs load and spares the limited Gemini/Groq/OpenRouter free tiers.
PROVIDER_PRIORITY=opencode,gemini,groq,openrouter
PROVIDER_RETRY_COUNT=1

# ---- Extraction quality validation ----
KEYWORDS_MIN=3
KEYWORDS_MAX=7

# ---- Uploads ----
MAX_UPLOAD_SIZE_BYTES=524288000

# ---- JWT / auth (backend) ----
Jwt__Secret=
Jwt__Issuer=YourApp
Jwt__Audience=YourAppUsers

# ---- AI service wiring (backend -> ai-service) ----
AiService__Enabled=false
AiService__BaseUrl=http://ai-service:8000
AiService__PollingIntervalSeconds=5
AiService__TimeoutMinutes=500
